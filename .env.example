# Copy to .env and fill in. .env is gitignored (and .dockerignored: never
# baked into the image — pass secrets to the container with -e instead).

# --- LLM providers (set the ones you use) ---
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# GOOGLE_API_KEY=  # accepted as an alias for GEMINI_API_KEY by the SDK

# --- deploy / container contract ---
# Data dir. Image default is /data/edl-agent (a bind mount on the host);
# local default is ./var. Must be owned by (or writable for) UID 1000,
# the user the container runs as.
#EDL_AGENT_VAR=
# Web server. scripts/run_web.py honors PORT (default 8000) and
# EDL_AGENT_HOST (local default 127.0.0.1; the image binds 0.0.0.0).
#PORT=8000
#EDL_AGENT_HOST=
# Timezone for log timestamps (needs no code support; OS-level via tzdata).
#TZ=
# Pin a full static ffmpeg when PATH order can't be trusted; ffprobe is
# resolved as its sibling when present (see docs/deployment.md #2).
#EDL_AGENT_FFMPEG=
# Ollama defaults to http://localhost:11434 (no env override; the image
# has no Ollama — use an API provider there).
